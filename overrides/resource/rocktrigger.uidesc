    <view class="CTextEdit" control-tag="Sound" origin="145, 660" size="385, 30"
          font="HeaderSmall" font-color="TextSoft" back-color="BG" frame-color="BG" style-no-frame="true"
          text-alignment="left" value-precision="0" transparent="true"/>
    <view class="CTextLabel" origin="815, 657" size="104, 36" title="LOAD..."
